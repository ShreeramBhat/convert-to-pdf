{
  "manifest_version": 3,
  "name": "Claude to PDF",
  "version": "1.0.6",
  "description": "Export a Claude chat or share link to a typeset PDF, including messages, code, images, artifacts, and attachments.",
  "permissions": ["storage", "scripting", "unlimitedStorage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Export this Claude chat to PDF",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*"],
      "js": [
        "src/util.js",
        "src/api.js",
        "src/markdown.js",
        "src/figure.js",
        "src/html.js",
        "src/test-suite.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
